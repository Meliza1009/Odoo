# ---------- Backend ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop
# Used only by `npm test` (a separate database that tests may wipe)
TEST_DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# Optional SMTP (MailHog locally). When SMTP_HOST is empty, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM="Brightloop <no-reply@brightloop.demo>"

# Optional recurring billing: catches up on startup and then checks hourly.
BILLING_SCHEDULE_ENABLED=false
BILLING_SCHEDULE_INTERVAL_MS=3600000
# Positive-total invoices stay draft unless this is true. Zero-total invoices are Paid.
BILLING_SCHEDULE_AUTO_CONFIRM=false

# ---------- Frontend ----------
VITE_API_URL=http://localhost:4000/api
