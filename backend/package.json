{
  "name": "brightloop-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Brightloop subscription management REST API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node --env-file-if-exists=../.env --import tsx src/db/migrate.ts",
    "seed": "node --env-file-if-exists=../.env --import tsx src/db/seed.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
